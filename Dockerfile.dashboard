# Dockerfile.dashboard
FROM node:20-alpine AS builder

WORKDIR /app
COPY dashboard/package*.json ./
RUN npm ci

COPY dashboard/ .

# NEXT_PUBLIC_* vars are inlined into the client bundle at build time, not
# read at container runtime — so this has to be a build ARG, passed via
# docker-compose's `build.args`, and must match the engine's ADMIN_API_KEY
# (.env) or every dashboard API call will get a 401 from admin/server.js.
ARG NEXT_PUBLIC_ADMIN_API_KEY
ENV NEXT_PUBLIC_ADMIN_API_KEY=$NEXT_PUBLIC_ADMIN_API_KEY

RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV production

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

EXPOSE 3001
ENV PORT 3001
ENV HOSTNAME "0.0.0.0"

CMD ["node", "server.js"]
