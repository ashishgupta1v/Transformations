# ════════════════════════════════════════════════════════
# SCIFI TRANSFORMATION PIPELINE — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your real values.
# Never commit the real .env file.
# ════════════════════════════════════════════════════════

# ── THEME SELECTION ─────────────────────────────────────
# Subject-specific content (which deity/location/product/business this
# pipeline run is about) lives in themes/*.json, not in this file — see
# themes/README.md. DEFAULT_THEME is only a fallback used when no
# --theme <name> flag is passed to the CLI or admin API.
DEFAULT_THEME=jagannatha-rathyatra

# Optional per-deployment override of the active theme's baseImageUrl
# field, without editing the theme JSON (e.g. swapping in a staging asset).
# Leave unset to use whatever baseImageUrl the theme file specifies.
BASE_IMAGE_URL_OVERRIDE=

# ── MUAPI.AI (all video generation + music — single aggregator key) ──
# 2026-06 migration: replaces fal.ai (Kling video), Replicate's Aleph
# (Tier C continuity), and the Suno-reseller (music score) with one
# muapi.ai key. Pay-as-you-go, no subscription. Sign up at
# https://muapi.ai, add a card, generate the key from the dashboard.
# Models used (fixed slugs, not env-configurable — see
# config/pipeline.config.js continuity.klingModel/alephModel):
#   kling-v2.1-standard-i2v — $0.045/s (Phase 1/2/3 image-to-video)
#   runway-aleph-v2v        — flat $0.90/call (Tier C continuity)
#   suno-create-music       — flat $0.09/call (music score, see
#                              src/audio/generator.js)
MUAPI_API_KEY=
MUAPI_BASE_URL=https://api.muapi.ai/api/v1

# ── FAL.AI (voice/SFX ONLY — video generation no longer uses fal.ai) ──
# As of the 2026-06 muapi.ai migration, fal.ai is retained solely as a
# legacy/optional key; ElevenLabs sound generation below calls ElevenLabs'
# own API directly and does NOT go through fal.ai's queue infrastructure.
# This key can be left blank unless some other integration still needs it.
FAL_API_KEY=

# ── ELEVENLABS (Ambient + Transformation sound effects) ─
ELEVENLABS_API_KEY=
ELEVENLABS_SFX_MODEL=eleven_text_to_sound_v2

# ── OPENAI (Prompt-to-Theme AI Generator) ───────────────
# Default is the standard OpenAI API.
# For free LLM testing, use a proxy like https://freellmapi.co/
# e.g., OPENAI_BASE_URL=https://api.freellmapi.co/v1
#       OPENAI_MODEL=gemini-1.5-pro
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ── REPLICATE (optional 4K upscale ONLY) ──
# As of the 2026-06 muapi.ai migration, Replicate is no longer used for
# Aleph/Tier C continuity (moved to muapi.ai's runway-aleph-v2v) — this
# key is only needed if ENABLE_UPSCALE=true. Sign up at
# https://replicate.com (GitHub/Google login works), add a card under
# Account -> Billing, then generate a key at
# https://replicate.com/account/api-tokens. Pay-as-you-go, no subscription.
REPLICATE_API_KEY=
REPLICATE_UPSCALE_MODEL=nightmareai/real-esrgan

# ── CONTINUITY (Option B: Aleph video-to-video phase chaining) ──
# Three tiers, increasing realism and cost:
#   A = each phase generated independently (no continuity, cheapest)
#   B = free ffmpeg last-frame extraction chained into next phase's
#       starting image ($0 extra, decent continuity)
#   C = true video-to-video via muapi.ai's Runway Gen-4 Aleph, which
#       actually transforms Phase 1's real rendered pixels into Phase 2
#       (flat $0.90/call regardless of length — most realistic, most
#       expensive; this is "Option B" architecture as discussed: Kling
#       i2v -> Aleph v2v -> Kling i2v)
# If Aleph fails or the request errors out, CONTINUITY_FALLBACK_ENABLED
# automatically falls back to Tier B for that run rather than failing it.
# (Aleph's model slug is now fixed at runway-aleph-v2v on muapi.ai — no
# longer an ALEPH_MODEL override, since muapi models aren't swappable by
# name the way Replicate's owner/name slugs were. Same for the old
# ALEPH_DURATION_SECONDS — muapi's Aleph has no duration field at all.)
CONTINUITY_TIER=C
CONTINUITY_FALLBACK_ENABLED=true
ENABLE_COLOR_MATCH=true

# First N successful Tier C (Aleph) runs are held for manual review instead
# of auto-publishing — see src/utils/reviewQueue.js and the admin API's
# GET /api/review/pending, POST /api/review/:runId/approve|reject. Once
# REVIEW_QUEUE_LIMIT runs have been approved/rejected, future Aleph runs
# auto-publish like any other tier.
ENABLE_REVIEW_QUEUE=true
REVIEW_QUEUE_LIMIT=8

# Hard monthly spend cap (USD) — checked before every Aleph call via
# costTracker.checkBudgetCircuitBreaker(). If projected spend would exceed
# this, the Aleph call is skipped and the run falls back to Tier B instead
# (same fallback path as a hard API failure).
MONTHLY_BUDGET_CAP_USD=50
COST_MUAPI_ALEPH_PER_CALL=0.90

# ── ORACLE CLOUD — OBJECT STORAGE (S3-compatible) ───────
# Generate a Customer Secret Key in OCI Console -> Identity -> Users
ORACLE_S3_ENDPOINT=https://your-namespace.compat.objectstorage.your-region.oraclecloud.com
ORACLE_S3_REGION=ap-mumbai-1
ORACLE_S3_ACCESS_KEY=
ORACLE_S3_SECRET_KEY=
ORACLE_NAMESPACE=
ORACLE_BUCKET=scifi-pipeline
# Legacy native REST fields (kept for reference/back-compat only)
ORACLE_STORAGE_URL=https://objectstorage.your-region.oraclecloud.com
ORACLE_ACCESS_KEY=

# ── YOUTUBE / YOUTUBE SHORTS ─────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# ── INSTAGRAM (Graph API via Facebook) ──────────────────
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# ── FACEBOOK ─────────────────────────────────────────────
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=

# ── TWITTER / X ───────────────────────────────────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ── WHATSAPP CLOUD API (notifications + status best-effort) ─
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_NOTIFY_NUMBER=
NOTIFY_ON_COMPLETE=true
NOTIFY_ON_ERROR=true

# ── LOCAL PATHS ───────────────────────────────────────────
TEMP_DIR=./temp
OUTPUT_DIR=./output
LOG_DIR=./logs
# Absolute deployment path, used by the n8n error-handler workflow to build
# log file paths on the server (only relevant when running via n8n/Docker).
PIPELINE_DIR=/opt/scifi-pipeline

# ── ADMIN WEB UI / TRIGGER API (used by n8n HTTP node) ────
ADMIN_PORT=3000
ADMIN_API_KEY=change-me-to-a-random-secret

# ── COST TRACKING (USD estimate per call, override as needed) ─
# COST_MUAPI_KLING_PER_CALL is the per-5s-phase cost ($0.045/s x 5s);
# src/video/generator.js's klingCostFor() scales this by duration/5 for
# 10s phases. See DEPLOYMENT_NOTES.md for the full per-phase cost math.
COST_MUAPI_KLING_PER_CALL=0.225
COST_ELEVENLABS_PER_CALL=0.10
COST_SUNO_PER_CALL=0.09
COST_REPLICATE_UPSCALE_PER_CALL=0.15
COST_OPENAI_PER_CALL=0.02

# ── n8n (Oracle Cloud VM docker-compose) ──────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_HOST=your-vm-ip-or-domain
N8N_WEBHOOK_URL=http://your-vm-ip-or-domain:5678/

NODE_ENV=production
