# ════════════════════════════════════════════════════════
# SCIFI TRANSFORMATION PIPELINE — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your real values.
# Never commit the real .env file.
# ════════════════════════════════════════════════════════

# ── THEME SELECTION ─────────────────────────────────────
# Subject-specific content (which deity/location/product/business this
# pipeline run is about) lives in themes/*.json, not in this file — see
# themes/README.md. DEFAULT_THEME is only a fallback used when no
# --theme <name> flag is passed to the CLI or admin API.
DEFAULT_THEME=jagannatha-rathyatra

# Optional per-deployment override of the active theme's baseImageUrl
# field, without editing the theme JSON (e.g. swapping in a staging asset).
# Leave unset to use whatever baseImageUrl the theme file specifies.
BASE_IMAGE_URL_OVERRIDE=

# ── RUNWAY (Phase 1 — Baseline) ─────────────────────────
RUNWAY_API_KEY=
RUNWAY_MODEL=gen3a_turbo
RUNWAY_API_VERSION=2024-11-06

# ── KLING AI (Phase 2 — SciFi Transformation) ───────────
KLING_API_KEY=

# ── PIKA LABS (Phase 3 — Resolution) ────────────────────
PIKA_API_KEY=

# ── ELEVENLABS (Ambient + Transformation sound effects) ─
ELEVENLABS_API_KEY=
ELEVENLABS_SFX_MODEL=eleven_text_to_sound_v2

# ── SUNO AI (Music score) ───────────────────────────────
SUNO_API_KEY=
SUNO_API_BASE_URL=https://api.sunoapi.org

# ── OPENAI (Prompt optimization, optional) ──────────────
OPENAI_API_KEY=

# ── REPLICATE (4K upscaling, optional) ──────────────────
REPLICATE_API_KEY=
REPLICATE_UPSCALE_MODEL=nightmareai/real-esrgan

# ── ORACLE CLOUD — OBJECT STORAGE (S3-compatible) ───────
# Generate a Customer Secret Key in OCI Console -> Identity -> Users
ORACLE_S3_ENDPOINT=https://your-namespace.compat.objectstorage.your-region.oraclecloud.com
ORACLE_S3_REGION=ap-mumbai-1
ORACLE_S3_ACCESS_KEY=
ORACLE_S3_SECRET_KEY=
ORACLE_NAMESPACE=
ORACLE_BUCKET=scifi-pipeline
# Legacy native REST fields (kept for reference/back-compat only)
ORACLE_STORAGE_URL=https://objectstorage.your-region.oraclecloud.com
ORACLE_ACCESS_KEY=

# ── YOUTUBE / YOUTUBE SHORTS ─────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# ── INSTAGRAM (Graph API via Facebook) ──────────────────
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# ── FACEBOOK ─────────────────────────────────────────────
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=

# ── TWITTER / X ───────────────────────────────────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ── WHATSAPP CLOUD API (notifications + status best-effort) ─
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_NOTIFY_NUMBER=
NOTIFY_ON_COMPLETE=true
NOTIFY_ON_ERROR=true

# ── LOCAL PATHS ───────────────────────────────────────────
TEMP_DIR=./temp
OUTPUT_DIR=./output
LOG_DIR=./logs
# Absolute deployment path, used by the n8n error-handler workflow to build
# log file paths on the server (only relevant when running via n8n/Docker).
PIPELINE_DIR=/opt/scifi-pipeline

# ── ADMIN WEB UI / TRIGGER API (used by n8n HTTP node) ────
ADMIN_PORT=3000
ADMIN_API_KEY=change-me-to-a-random-secret

# ── COST TRACKING (USD estimate per call, override as needed) ─
COST_RUNWAY_PER_CALL=0.50
COST_KLING_PER_CALL=0.70
COST_PIKA_PER_CALL=0.35
COST_ELEVENLABS_PER_CALL=0.10
COST_SUNO_PER_CALL=0.20
COST_REPLICATE_UPSCALE_PER_CALL=0.15
COST_OPENAI_PER_CALL=0.02

# ── n8n (Oracle Cloud VM docker-compose) ──────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_HOST=your-vm-ip-or-domain
N8N_WEBHOOK_URL=http://your-vm-ip-or-domain:5678/

NODE_ENV=production
