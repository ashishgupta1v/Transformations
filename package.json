{
  "name": "scifi-transformation-pipeline",
  "version": "2.0.0",
  "description": "Generic AI-powered SciFi Transformation Video Pipeline — generates and publishes a 3-phase baseline-to-scifi-to-resolution video for any deity, location, product, or business via a swappable theme file (see themes/)",
  "main": "src/index.js",
  "author": "Ashish Gupta <ashish@digitalbuilders.in>",
  "license": "MIT",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "generate": "node src/index.js generate",
    "publish": "node src/index.js publish",
    "test-apis": "node scripts/test-apis.js",
    "cost-report": "node src/index.js cost-report",
    "schedule": "node src/index.js schedule",
    "admin": "node admin/server.js",
    "dashboard": "node monitoring/server.js",
    "test": "jest tests/",
    "lint": "eslint src/ admin/ scripts/ --fix",
    "setup": "bash scripts/setup.sh",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
