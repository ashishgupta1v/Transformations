    "axios": "^1.6.0",
    "bullmq": "^5.79.0",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.19.2",
    "fluent-ffmpeg": "^2.1.2",
    "form-data": "^4.0.0",
    "fs-extra": "^11.2.0",
    "googleapis": "^140.0.1",
    "ioredis": "^5.11.1",
    "node-cron": "^3.0.3",
    "openai": "^6.44.0",
    "ora": "^5.4.1",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "socket.io": "^4.8.3",
    "twitter-api-v2": "^1.17.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
