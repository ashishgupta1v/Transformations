{
  "name": "Jagannatha SciFi Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 2 * * 1" }]
        }
      },
      "id": "trigger-node",
      "name": "Weekly Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/pipeline/start",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "mode", "value": "full" },
            { "name": "project", "value": "jagannatha-scifi" },
            { "name": "timestamp", "value": "={{$now.toISO()}}" }
          ]
        },
        "options": { "timeout": 3600000 }
      },
      "id": "start-pipeline",
      "name": "Start Pipeline API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [300, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.dev.runwayml.com/v1/image_to_video",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Runway-Version", "value": "2024-11-06" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "promptImage", "value": "={{$env.BASE_IMAGE_URL}}" },
            { "name": "promptText", "value": "Sacred Jagannatha Temple Puri night Rath Yatra diyas chariots Bay of Bengal cinematic drone orbit golden sacred lighting 24fps ultra-realistic" },
            { "name": "model", "value": "gen3a_turbo" },
            { "name": "duration", "value": 5 },
            { "name": "ratio", "value": "768:768" }
          ]
        }
      },
      "id": "runway-generate",
      "name": "Runway — Generate Phase 1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [500, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.klingai.com/v1/videos/video-to-video",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "input_video_url", "value": "={{$node['Poll-Runway'].json.output[0]}}" },
            { "name": "prompt", "value": "SCIFI TRANSFORMATION Temple sandstone cracks plasma energy cores Nilachakra quantum portal chariots levitate anti-gravity rings devotees holographic chrome Garuda robot Vimana spacecraft sacred geometry Earth energy nexus" },
            { "name": "cfg_scale", "value": 0.7 },
            { "name": "mode", "value": "pro" },
            { "name": "duration", "value": 10 }
          ]
        }
      },
      "id": "kling-generate",
      "name": "Kling AI — SciFi Transform",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [700, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.elevenlabs.io/v1/sound-generation",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "xi-api-key", "value": "={{$env.ELEVENLABS_API_KEY}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "text", "value": "Sacred Hindu temple bells mardala drums Jai Jagannath crowd chant conch shell mahuri Rath Yatra procession Bay of Bengal ocean waves diya crackle festival night Puri" },
            { "name": "duration_seconds", "value": 15 },
            { "name": "prompt_influence", "value": 0.3 }
          ]
        }
      },
      "id": "elevenlabs-sacred",
      "name": "ElevenLabs — Sacred Audio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [500, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.elevenlabs.io/v1/sound-generation",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "xi-api-key", "value": "={{$env.ELEVENLABS_API_KEY}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "text", "value": "Quantum portal opening bass whomp anti-gravity engine powering up tesla coil electrical discharge robotic divine army footsteps chrome eagle screech plasma energy beams Sanskrit cosmic drone reactor activation Vimana descent dimensional portal" },
            { "name": "duration_seconds", "value": 15 },
            { "name": "prompt_influence", "value": 0.5 }
          ]
        }
      },
      "id": "elevenlabs-scifi",
      "name": "ElevenLabs — SciFi Audio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [700, 400]
    },
    {
      "parameters": {
        "command": "cd /home/opc/jagannatha-pipeline && node src/index.js assemble --phase1 '={{$node[\"Poll-Runway\"].json.output[0]}}' --phase2 '={{$node[\"Poll-Kling\"].json.url}}' --sacred-audio '={{$node[\"ElevenLabs-Sacred\"].json.path}}' --scifi-audio '={{$node[\"ElevenLabs-SciFi\"].json.path}}'"
      },
      "id": "ffmpeg-assemble",
      "name": "FFmpeg — Assemble Master",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "command": "cd /home/opc/jagannatha-pipeline && node src/index.js publish --all"
      },
      "id": "publish-all",
      "name": "Publish All Platforms",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v18.0/={{$env.WHATSAPP_PHONE_ID}}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer ={{$env.WHATSAPP_TOKEN}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "messaging_product", "value": "whatsapp" },
            { "name": "to", "value": "={{$env.WHATSAPP_NOTIFY_NUMBER}}" },
            { "name": "type", "value": "text" },
            { "name": "text", "value": "{\"body\": \"✅ Jagannatha SciFi Video COMPLETE! 🙏\\n\\nAll platforms published successfully.\\n\\nJAI JAGANNATH! 🪔🎆\"}" }
          ]
        }
      },
      "id": "notify-whatsapp",
      "name": "Notify via WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1300, 300]
    }
  ],
  "connections": {
    "Weekly Schedule Trigger": {
      "main": [[{ "node": "Start Pipeline API", "type": "main", "index": 0 }]]
    },
    "Start Pipeline API": {
      "main": [[
        { "node": "Runway — Generate Phase 1", "type": "main", "index": 0 },
        { "node": "ElevenLabs — Sacred Audio", "type": "main", "index": 0 },
        { "node": "ElevenLabs — SciFi Audio", "type": "main", "index": 0 }
      ]]
    },
    "Runway — Generate Phase 1": {
      "main": [[{ "node": "Kling AI — SciFi Transform", "type": "main", "index": 0 }]]
    },
    "Kling AI — SciFi Transform": {
      "main": [[{ "node": "FFmpeg — Assemble Master", "type": "main", "index": 0 }]]
    },
    "ElevenLabs — Sacred Audio": {
      "main": [[{ "node": "FFmpeg — Assemble Master", "type": "main", "index": 0 }]]
    },
    "ElevenLabs — SciFi Audio": {
      "main": [[{ "node": "FFmpeg — Assemble Master", "type": "main", "index": 0 }]]
    },
    "FFmpeg — Assemble Master": {
      "main": [[{ "node": "Publish All Platforms", "type": "main", "index": 0 }]]
    },
    "Publish All Platforms": {
      "main": [[{ "node": "Notify via WhatsApp", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": "error-handler-workflow"
  },
  "tags": ["jagannath", "video-pipeline", "scifi", "sacred"],
  "meta": {
    "instanceId": "jagannatha-pipeline-v1"
  }
}
