{
  "name": "SciFi Transformation Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 2 * * 1" }]
        }
      },
      "id": "trigger-node",
      "name": "Weekly Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "theme-id-assignment",
              "name": "themeId",
              "value": "={{$env.DEFAULT_THEME || 'jagannatha-rathyatra'}}",
              "type": "string"
            }
          ]
        }
      },
      "id": "set-theme",
      "name": "Set Theme",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [300, 300],
      "notes": "Which theme (themes/*.json) this scheduled run uses. Override DEFAULT_THEME in n8n's environment, or edit the fallback value here, to point this schedule at any deity, location, product, or business theme."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{\"http://localhost:\" + ($env.ADMIN_PORT || 3000) + \"/api/pipeline/start\"}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{$env.ADMIN_API_KEY}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "theme", "value": "={{$node[\"Set Theme\"].json.themeId}}" },
            { "name": "timestamp", "value": "={{$now.toISO()}}" }
          ]
        },
        "options": { "timeout": 30000 }
      },
      "id": "start-pipeline",
      "name": "Start Pipeline API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [500, 300],
      "notes": "Kicks off the full generate -> assemble -> publish -> notify pipeline (src/index.js runPipeline) for the chosen theme. The admin server runs this asynchronously and returns immediately (202) -- actual progress is polled below, not read from this response."
    },
    {
      "parameters": { "amount": 2, "unit": "minutes" },
      "id": "wait-poll",
      "name": "Wait 2 Minutes",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [700, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{\"http://localhost:\" + ($env.ADMIN_PORT || 3000) + \"/api/pipeline/status\"}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{$env.ADMIN_API_KEY}}" }
          ]
        },
        "options": { "timeout": 15000 }
      },
      "id": "check-status",
      "name": "Check Pipeline Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [900, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{$json.status}}",
              "rightValue": "running",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "id": "is-still-running",
      "name": "Is Still Running?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{$json.status}}",
              "rightValue": "failed",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "id": "did-it-fail",
      "name": "Did It Fail?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1300, 420]
    },
    {
      "parameters": {
        "jsCode": "throw new Error(`Pipeline failed (theme: ${$json.theme || 'unknown'}, runId: ${$json.runId || 'unknown'}): ${$json.error || 'unknown error'}`);"
      },
      "id": "throw-error",
      "name": "Throw Pipeline Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1500, 500],
      "notes": "Throwing here triggers this workflow's configured errorWorkflow (error-handler-workflow.json), which sends the notification alert."
    },
    {
      "parameters": {},
      "id": "pipeline-complete",
      "name": "Pipeline Complete",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1500, 340],
      "notes": "Notification of success is handled inside the pipeline itself (whatsapp.notifyCompletion, theme-driven) -- nothing further to do here."
    }
  ],
  "connections": {
    "Weekly Schedule Trigger": {
      "main": [[{ "node": "Set Theme", "type": "main", "index": 0 }]]
    },
    "Set Theme": {
      "main": [[{ "node": "Start Pipeline API", "type": "main", "index": 0 }]]
    },
    "Start Pipeline API": {
      "main": [[{ "node": "Wait 2 Minutes", "type": "main", "index": 0 }]]
    },
    "Wait 2 Minutes": {
      "main": [[{ "node": "Check Pipeline Status", "type": "main", "index": 0 }]]
    },
    "Check Pipeline Status": {
      "main": [[{ "node": "Is Still Running?", "type": "main", "index": 0 }]]
    },
    "Is Still Running?": {
      "main": [
        [{ "node": "Wait 2 Minutes", "type": "main", "index": 0 }],
        [{ "node": "Did It Fail?", "type": "main", "index": 0 }]
      ]
    },
    "Did It Fail?": {
      "main": [
        [{ "node": "Throw Pipeline Error", "type": "main", "index": 0 }],
        [{ "node": "Pipeline Complete", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": "error-handler-workflow"
  },
  "tags": ["scifi-pipeline", "video-pipeline", "generic"],
  "meta": {
    "instanceId": "scifi-transformation-pipeline-v2"
  }
}
